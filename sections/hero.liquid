<section class="hero{% if section.settings.alignment == 'center' %} hero--center{% endif %}">
  <div class="hero__media">
    {%- if section.settings.video != blank -%}
      {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, class: 'hero__video' }}
    {%- elsif section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2400 | image_tag:
        loading: 'eager',
        fetchpriority: 'high',
        widths: '1200, 1600, 2000, 2400',
        sizes: '100vw',
        alt: section.settings.image.alt | default: section.settings.heading | escape
      }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'hero__placeholder' }}
    {%- endif -%}
  </div>
  <div class="hero__overlay" style="opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"></div>
  <div class="hero__content">
    <div class="page-width">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h1 class="hero__title h-display">{{ section.settings.heading }}</h1>
      {%- endif -%}
      {%- if section.settings.subtext != blank -%}
        <p class="hero__sub">{{ section.settings.subtext }}</p>
      {%- endif -%}
      <div class="hero__ctas">
        {%- if section.settings.cta_label_1 != blank -%}
          <a href="{{ section.settings.cta_link_1 | default: routes.all_products_collection_url }}" class="btn">{{ section.settings.cta_label_1 }}</a>
        {%- endif -%}
        {%- if section.settings.cta_label_2 != blank -%}
          <a href="{{ section.settings.cta_link_2 | default: routes.all_products_collection_url }}" class="btn btn--secondary">{{ section.settings.cta_label_2 }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.hero.name",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "t:sections.hero.settings.image.label", "info": "t:sections.hero.settings.image.info" },
    { "type": "video", "id": "video", "label": "t:sections.hero.settings.video.label" },
    { "type": "text", "id": "eyebrow", "label": "t:sections.hero.settings.eyebrow.label", "default": "Fall / Winter 2026" },
    { "type": "text", "id": "heading", "label": "t:sections.hero.settings.heading.label", "default": "Dress like you mean it" },
    { "type": "textarea", "id": "subtext", "label": "t:sections.hero.settings.subtext.label", "default": "Sharp tailoring, heavyweight staples and statement pieces — built for the season, made to keep." },
    { "type": "text", "id": "cta_label_1", "label": "t:sections.hero.settings.cta_label_1.label", "default": "Shop new arrivals" },
    { "type": "url", "id": "cta_link_1", "label": "t:sections.hero.settings.cta_link_1.label" },
    { "type": "text", "id": "cta_label_2", "label": "t:sections.hero.settings.cta_label_2.label", "default": "Explore lookbook" },
    { "type": "url", "id": "cta_link_2", "label": "t:sections.hero.settings.cta_link_2.label" },
    { "type": "select", "id": "alignment", "label": "t:sections.hero.settings.alignment.label", "default": "left", "options": [
      { "value": "left", "label": "t:sections.hero.settings.alignment.left" },
      { "value": "center", "label": "t:sections.hero.settings.alignment.center" }
    ]},
    { "type": "range", "id": "overlay_opacity", "label": "t:sections.hero.settings.overlay_opacity.label", "min": 0, "max": 90, "step": 5, "default": 45, "unit": "%" }
  ],
  "presets": [{ "name": "t:sections.hero.name" }]
}
{% endschema %}
