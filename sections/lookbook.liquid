<div class="section" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    <div class="section-heading{% if section.settings.heading_alignment == 'center' %} section-heading--center{% endif %}">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="h2">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>
    <div class="lookbook-grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign link = block.settings.product_url | default: block.settings.link
        -%}
        <a class="lookbook-item" href="{{ link | default: '#' }}" {{ block.shopify_attributes }} aria-label="{{ block.settings.caption | default: 'Lookbook image' | escape }}">
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 1000 | image_tag:
              loading: 'lazy',
              widths: '500, 800, 1000',
              sizes: '(min-width: 990px) 25vw, 50vw',
              alt: block.settings.image.alt | default: block.settings.caption | escape
            }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag }}
          {%- endif -%}
          {%- if block.settings.caption != blank -%}
            <span class="lookbook-item__tag">{{ block.settings.caption }}</span>
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.lookbook.name",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:sections.hero.settings.eyebrow.label", "default": "FW26 Lookbook" },
    { "type": "text", "id": "heading", "label": "t:sections.lookbook.settings.heading.label", "default": "Styled on the street" },
    { "type": "select", "id": "heading_alignment", "label": "t:sections.featured-collection.settings.heading_alignment.label", "default": "left", "options": [
      { "value": "left", "label": "t:sections.hero.settings.alignment.left" },
      { "value": "center", "label": "t:sections.hero.settings.alignment.center" }
    ]},
    { "type": "range", "id": "padding_top", "label": "t:sections.common.padding_top", "min": 0, "max": 120, "step": 4, "default": 64, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "t:sections.common.padding_bottom", "min": 0, "max": 120, "step": 4, "default": 64, "unit": "px" }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "t:sections.lookbook.blocks.image.name",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "t:sections.lookbook.blocks.image.settings.image.label" },
        { "type": "text", "id": "caption", "label": "t:sections.lookbook.blocks.image.settings.caption.label", "default": "The trench, styled" },
        { "type": "product", "id": "product_url", "label": "t:sections.lookbook.blocks.image.settings.product.label" },
        { "type": "url", "id": "link", "label": "t:sections.lookbook.blocks.image.settings.link.label" }
      ]
    }
  ],
  "presets": [{ "name": "t:sections.lookbook.name", "blocks": [{ "type": "image" }, { "type": "image" }, { "type": "image" }, { "type": "image" }, { "type": "image" }] }]
}
{% endschema %}
