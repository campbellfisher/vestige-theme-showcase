<div class="section" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div class="section-heading">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="h2">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="ba" data-ba style="--pos: 50;">
      <div class="ba__layer ba__layer--bottom">
        {%- if section.settings.after_image != blank -%}
          {{ section.settings.after_image | image_url: width: 1600 | image_tag: loading: 'lazy', class: 'ba__img', alt: section.settings.after_label }}
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'ba__img ba__placeholder' }}
        {%- endif -%}
        <span class="ba__label ba__label--right">{{ section.settings.after_label }}</span>
      </div>
      <div class="ba__layer ba__layer--top" aria-hidden="true">
        {%- if section.settings.before_image != blank -%}
          {{ section.settings.before_image | image_url: width: 1600 | image_tag: loading: 'lazy', class: 'ba__img', alt: section.settings.before_label }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'ba__img ba__placeholder' }}
        {%- endif -%}
        <span class="ba__label ba__label--left">{{ section.settings.before_label }}</span>
      </div>
      <div class="ba__handle" aria-hidden="true"><span class="ba__knob"></span></div>
      <input type="range" class="ba__range" min="0" max="100" value="50" step="1"
        aria-label="{{ section.settings.before_label | escape }} / {{ section.settings.after_label | escape }}"
        data-ba-range>
    </div>
  </div>
</div>

<style>
  .ba{position:relative;overflow:hidden;border-radius:8px;aspect-ratio:16/9;background:var(--color-card);}
  .ba__layer{position:absolute;inset:0;}
  .ba__img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;}
  .ba__placeholder{width:100%;height:100%;}
  .ba__layer--top{clip-path:inset(0 calc((100 - var(--pos)) * 1%) 0 0);}
  .ba__handle{position:absolute;top:0;bottom:0;left:calc(var(--pos) * 1%);width:2px;background:#fff;box-shadow:0 0 8px rgba(0,0,0,.35);transform:translateX(-50%);pointer-events:none;}
  .ba__knob{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:44px;height:44px;border-radius:50%;background:#fff;box-shadow:0 2px 10px rgba(0,0,0,.3);}
  .ba__knob::before,.ba__knob::after{content:'';position:absolute;top:50%;border:solid var(--color-text);border-width:0 2px 2px 0;width:9px;height:9px;}
  .ba__knob::before{left:38%;transform:translate(-50%,-50%) rotate(135deg);}
  .ba__knob::after{left:62%;transform:translate(-50%,-50%) rotate(-45deg);}
  .ba__label{position:absolute;top:1rem;z-index:2;padding:.4rem .8rem;font-size:.75rem;letter-spacing:.08em;text-transform:uppercase;color:#fff;background:rgba(0,0,0,.55);border-radius:999px;}
  .ba__label--left{left:1rem;}
  .ba__label--right{right:1rem;}
  .ba__range{position:absolute;inset:0;width:100%;height:100%;margin:0;opacity:0;cursor:ew-resize;}
  .ba__range:focus-visible + *,.ba:focus-within .ba__handle{outline:2px solid var(--color-accent);outline-offset:2px;}
  @media (max-width: 749px){ .ba{aspect-ratio:4/3;} }
</style>

<script>
(function(){
  document.querySelectorAll('[data-ba]').forEach(function(root){
    var range = root.querySelector('[data-ba-range]');
    if (!root || !range) return;
    range.addEventListener('input', function(){
      root.style.setProperty('--pos', range.value);
    });
  });
})();
</script>

{% schema %}
{
  "name": "t:sections.before-after.name",
  "settings": [
    { "type": "image_picker", "id": "before_image", "label": "t:sections.before-after.settings.before_image.label" },
    { "type": "image_picker", "id": "after_image", "label": "t:sections.before-after.settings.after_image.label" },
    { "type": "text", "id": "before_label", "label": "t:sections.before-after.settings.before_label.label", "default": "Before" },
    { "type": "text", "id": "after_label", "label": "t:sections.before-after.settings.after_label.label", "default": "After" },
    { "type": "text", "id": "eyebrow", "label": "t:sections.hero.settings.eyebrow.label" },
    { "type": "text", "id": "heading", "label": "t:sections.hero.settings.heading.label" },
    { "type": "range", "id": "padding_top", "label": "t:sections.common.padding_top", "min": 0, "max": 120, "step": 4, "default": 64, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "t:sections.common.padding_bottom", "min": 0, "max": 120, "step": 4, "default": 64, "unit": "px" }
  ],
  "presets": [{ "name": "t:sections.before-after.name" }]
}
{% endschema %}
