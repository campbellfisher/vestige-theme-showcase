<div class="cart-drawer" id="cart-drawer" role="dialog" aria-modal="true" aria-label="{{ 'cart.general.title' | t }}">
  <div class="cart-drawer__scrim" data-close-drawer></div>
  <div class="cart-drawer__panel">
    <div class="cart-drawer__head">
      <h2>{{ 'cart.general.title' | t }} (<span class="cart-count">{{ cart.item_count }}</span>)</h2>
      <button type="button" class="icon-btn" data-close-drawer aria-label="{{ 'accessibility.close' | t }}">
        {%- render 'icons', icon: 'close' -%}
      </button>
    </div>
    <div class="cart-drawer__items" aria-live="polite" aria-busy="false"></div>
    <div class="cart-drawer__foot">
      <p class="cart-taxes">
        {%- if cart.taxes_included and shop.shipping_policy.body != blank -%}
          {{ 'cart.general.taxes_included_and_shipping_policy_html' | t: link: shop.shipping_policy.url }}
        {%- elsif cart.taxes_included -%}
          {{ 'cart.general.taxes_included_but_shipping_at_checkout' | t }}
        {%- elsif shop.shipping_policy.body != blank -%}
          {{ 'cart.general.taxes_and_shipping_policy_at_checkout_html' | t: link: shop.shipping_policy.url }}
        {%- else -%}
          {{ 'cart.general.taxes_and_shipping_at_checkout' | t }}
        {%- endif -%}
      </p>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.cart-drawer.name",
  "enabled_on": { "groups": ["footer"] },
  "settings": [
    { "type": "paragraph", "content": "t:sections.cart-drawer.settings.info" }
  ],
  "presets": [{ "name": "t:sections.cart-drawer.name" }]
}
{% endschema %}
